  "schemaVersion": 1,
  "id": "moergo/glove80",
  "name": "Glove80",
  "vendor": "MoErgo",
  "firmware": "zmk",
  "keyCount": 80,
  "revisions": [
    {
      "id": "default",
      "source": {
        "repo": "https://github.com/moergo-sc/zmk",
        "ref": "v26.09",
        "sha": "ce69e85f585c724142aae37ddf8a7e019ff19e93"
      },
      "build": {
        "kind": "zmk-moergo-template",
        "template": {
          "repo": "https://github.com/moergo-sc/glove80-zmk-config",
          "sha": "34888be8c9d9a3d5b168a502b8b191ba43b4a1f3"
        },
        "physicalLayout": "app/boards/arm/glove80/glove80-layouts.dtsi"
      },
      "flash": {
        "kind": "uf2-drives",
        "steps": [
          {
            "volume": "GLV80RHBOOT",
            "label": "right half",
            "enter": "With the right half switched off and its USB cable connected, hold I + PgDn and switch it on. A slowly pulsing red light by the power switch means it's ready. On a running layout, Magic + ' does the same."
          },
          {
            "volume": "GLV80LHBOOT",
            "label": "left half",
            "enter": "With the left half switched off and its USB cable connected, hold Magic + E and switch it on. A slowly pulsing red light by the power switch means it's ready. On a running layout, Magic + Esc does the same."
          }
        ],
        "handsFree": {
          "trigger": "cdc-1200",
          "usbVendorId": "0x16c0",
          "halves": [
            { "role": "central", "step": "left half", "marker": "L", "usbProductId": "0x27db" },
            { "role": "peripheral", "step": "right half", "marker": "R", "usbProductId": "0x27d9", "relay": true }
          ],
          "serialMarker": "usb-sn-template",
          "serialTail": ":GLV80-0123456789ABCDEF"
        }
      },
      "detect": {
        "usbProductId": "0x27db"
      }
    }
  ],
