{
  "name": "keyloom",
  "version": "0.48.1",
  "private": true,
  "description": "Open-source, local-first keyboard configurator for QMK and ZMK boards, with an agent that proposes validated layout changes.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "keyloom": "src/cli/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "evals": "bun test --config ./evals/bunfig.toml ./evals/scenarios",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "gen:keycodes": "bun scripts/gen-keycodes.ts",
    "gen:keyboard-index": "bun scripts/gen-keyboard-index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "15.0.0",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-devicetree": "0.15.0",
    "ulid": "3.0.2",
    "web-tree-sitter": "0.27.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@swc/core": "1.16.13",
    "@types/bun": "1.4.2",
    "@types/hjson": "2.4.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "18.5.0",
    "fast-check": "4.10.1",
    "hjson": "3.2.2",
    "typescript": "7.0.2"
  }
}
