/*
 * Written by hand in the style of the MoErgo Layout Editor's export, to cover what the template's
 * default keymap lacks: modelled hold-taps, macros and combos. Not an export.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#define HYPER LC(LS(LG(LALT)))
#define LAYER_Base 0
#define LAYER_Nav 1
#define LAYER_Magic 2

/ {
    behaviors {
        // Home-row mods: the other hand's keys are the only ones that can trigger a hold.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42 43 44 45>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        lt_sp: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SPACE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&kp>;
        };

        td_mute: tap_dance_mute {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MUTE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C_MUTE>, <&kp C_PP>;
        };
    };

    macros {
        opt_opt: macro_opt_opt {
            label = "OPT_OPT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LA(LALT)>
                ;
        };

        paste_twice: macro_paste_twice {
            label = "PASTE_TWICE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp LG(V)>
                , <&macro_wait_time 40>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp LG(V)>
                ;
        };

        timed: macro_with_timing {
            label = "TIMED";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp A &kp B>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <40>;
            key-positions = <12 13>;
            layers = <(-1)>;
            bindings = <&kp ESC>;
        };

        combo_caps {
            key-positions = <35 36 37>;
            layers = <LAYER_Base LAYER_Nav>;
            bindings = <&caps_word>;
        };

        combo_slow {
            timeout-ms = <60>;
            key-positions = <26 27>;
            slow-release;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_Base {
            display-name = "Base";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
                &kp ESC  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &kp G  &kp H  &hm LSHIFT J  &hm LCTRL K  &hm LALT L  &hm LGUI SEMI  &kp SQT
                &kp GRAVE  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LSHFT  &kp LCTRL  &lt 1 SPACE  &kp LGUI  &kp RCTRL  &kp RSHFT  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp PG_UP
                &mt LCTRL ESC  &kp HOME  &kp END  &kp LEFT  &kp RIGHT  &kp BSPC  &kp DEL  &opt_opt  &kp RALT  &kp RET  &kp LC(LS(N4))  &kp UP  &kp DOWN  &kp LBKT  &lt_sp 2 SPACE  &kp HYPER
            >;
        };
        layer_Nav {
            bindings = <
                &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &none  &none  &none  &none  &none  &none  &caps_word
                &trans  &sl 0  &tog 2  &to 0  &none  &none  &none  &paste_twice  &none  &none  &none  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        layer_Magic {
            bindings = <
                &bt BT_CLR  &bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

&mt {
    tapping-term-ms = <175>;
};

&sk {
    release-after-ms = <900>;
};
