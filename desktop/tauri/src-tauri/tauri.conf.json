{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keyloom",
  "version": "0.0.0",
  "identifier": "dev.planetaryescape.keyloom",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": { "csp": null },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first keyboard configurator for QMK and ZMK boards",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/keyloom"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
